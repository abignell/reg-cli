{
  "name": "@atlassian/reg-cli",
  "version": "1.1.0",
  "description": "",
  "main": "./dist/index.js",
  "start": "node ./dist/cli.js",
  "type": "module",
  "scripts": {
    "lint": "biome lint src test",
    "lint:fix": "biome lint --write src test",
    "format": "biome format src test",
    "format:fix": "biome format --write src test",
    "check": "biome check src test",
    "check:fix": "biome check --write src test",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -- watch",
    "build": "yarn build:cli && yarn build:report",
    "build:cli": "tsc",
    "build:report": "sh ./scripts/build-ui.sh support-flake-marker",
    "copy:ximgdiff": "copyfiles -u 3 node_modules/x-img-diff-js/build/cv-wasm_browser.* report/assets",
    "prepublishOnly": "npm run build",
    "reg": "node dist/cli.js ./sample/actual ./sample/expected ./sample/diff -I -R ./sample/index.html -T 0.01 -X client",
    "reg:from": "node dist/cli.js -F ./sample/reg.json -R ./sample/index.html",
    "screenshot": "tsx test/screenshot.ts",
    "test:cli": "chmod +x dist/cli.js && ava test/cli.test.ts",
    "test:screenshot": "npm run build:report && npm run reg && npm run screenshot",
    "test": "NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=debug npm run build:report && npm run build && npm run test:cli && npm run test:screenshot"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abignell/reg-cli/"
  },
  "ava": {
    "workerThreads": false
  },
  "author": "bokuweb",
  "license": "MIT",
  "dependencies": {
    "bluebird": "3.7.2",
    "chalk": "4.1.2",
    "cli-spinner": "0.2.10",
    "cross-spawn": "7.0.6",
    "del": "8.0.1",
    "glob": "13.0.0",
    "img-diff-js": "0.5.4",
    "jpeg-js": "0.4.4",
    "lodash": "4.17.23",
    "make-dir": "3.1.0",
    "md5-file": "5.0.0",
    "meow": "^9.0.0",
    "mustache": "4.2.0",
    "x-img-diff-js": "0.3.5",
    "xmlbuilder2": "^4.0.3",
    "yargs-parser": "^21.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/bluebird": "^3.5.42",
    "@types/cli-spinner": "^0.2.3",
    "@types/lodash": "^4.17.23",
    "@types/md5-file": "^5.0.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^25.1.0",
    "ava": "6.4.1",
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "finalhandler": "2.1.1",
    "flow-bin": "0.77.0",
    "flow-typed": "4.1.1",
    "puppeteer": "24.34.0",
    "rimraf": "3.0.2",
    "serve-static": "2.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "template",
    "report/ui/dist/report.js",
    "report/ui/dist/worker.js",
    "report/ui/dist/style.css",
    "report/assets/favicon_failure.png",
    "report/assets/favicon_success.png",
    "report/sample"
  ],
  "bin": {
    "atlassian-reg-cli": "./dist/cli.js"
  },
  "packageManager": "yarn@4.12.0"
}
