{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": "node 18",
        "modules": false
      }
    ]
  ],
  "plugins": [
    "@babel/plugin-transform-flow-strip-types",
    [
      "@babel/plugin-transform-block-scoping",
      {
        "throwIfClosureRequired": true
      }
    ]
  ]
}